<library>
  <repositories>
    <repository>
      <path>../repo.lb</path>
    </repository>
  </repositories>
  <options>
    <option name="taproot:docs:source_paths">src</option>
    <option name="taproot:rebuild_modm">True</option>

    <!-- Makes sure that the code configures and compiles -->
    <option name="taproot:board:digital_in_pins"></option>
    <option name="taproot:board:digital_out_pins">Laser</option>
    <option name="taproot:board:pwm_pins"></option>

    <option name="taproot:dev_board">$BOARD$</option>

    $OPTIONS$
  </options>
  <modules>
    <module>taproot:build</module>    
    <module>taproot:modm-project.xml</module>

    <module>taproot:testing:tests</module>
    <module>taproot:testing:mock</module>

    $MODULES$
  </modules>
</library>
