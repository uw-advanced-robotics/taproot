import os
import shutil

def init(module):
    module.name = ":docs"
    module.description = "Doxygen Doc Generation"

def prepare(module, options):
    module.add_option(StringOption(
        name="source_paths",
        default="",
        description="A space-separated list of file directories to search" \
                    "through recursively when generating documentation." \
                    "These directories should be relative to the directory in"
                    "which your project.xml is located"))

    module.depends(":core")

    return True

def convert_md_to_rst(source_path, dest_path, title="Changelog"):
    """
    Simple helper to convert Markdown headers to RST headers.
    """
    if not os.path.exists(source_path):
        print(f"Warning: Source file {source_path} not found. Skipping conversion.")
        return
    else:
        print(f"Converting file at {source_path} to {dest_path}")

    # Ensure the destination directory exists before creating the file
    dest_dir = os.path.dirname(dest_path)
    if dest_dir and not os.path.exists(dest_dir):
        os.makedirs(dest_dir)

    with open(source_path, "r") as f_in, open(dest_path, "w") as f_out:
        # Write the Main Document Title (Level 1)
        f_out.write(f"{title}\n")
        f_out.write("=" * len(title) + "\n\n")
        
        for line in f_in:
            if line.startswith("# "):
                content = line.strip("# \n")
                f_out.write(content + "\n")
                f_out.write("-" * len(content) + "\n\n")
            elif line.startswith("## "):
                content = line.strip("# \n")
                f_out.write(content + "\n")
                f_out.write("^" * len(content) + "\n\n")
            elif line.startswith("### "):
                content = line.strip("# \n")
                f_out.write(content + "\n")
                f_out.write("~" * len(content) + "\n\n")
            else:
                f_out.write(line)

def build(env):
    # Parse source_paths. Since the user specifies a path relative to their
    # project.xml file, we must add ../.. to the paths such that the paths are
    # relative to taproot/docs
    source_paths = env["source_paths"].split(" ")
    source_paths = [ os.path.join("../..", path) for path in source_paths ]
    source_paths = " ".join(source_paths)

    env.substitutions = { "source_paths": source_paths }
    env.outbasepath = "taproot/docs"

    # convert old changelog into a .rst for use in the generated docs
    changelog_src = os.path.abspath("../CHANGELOG.md") 
    changelog_dest = os.path.join(env.outbasepath, "changelog.rst")
    convert_md_to_rst(changelog_src, changelog_dest)

    env.template("Doxyfile.in", "Doxyfile")
    env.template("conf.py.in", "conf.py")
    env.copy("index.rst")
    env.copy("make.bat")
    env.copy("Makefile")
    env.copy("module.rst")
    
    guides_src = "guides"
    guides_dest = os.path.join(env.outbasepath, "guides")

    if os.path.exists(guides_src):
        # Clean destination if it exists to ensure updates are captured
        if os.path.exists(guides_dest):
            shutil.rmtree(guides_dest)
        shutil.copytree(guides_src, guides_dest)


    # --- CI DEBUGGING BLOCK ---
    print("\n--- DEBUG: FILE LISTING ---")
    target_file = os.path.join(env.outbasepath, "changelog.rst")
    
    if os.path.exists(target_file):
        print(f"SUCCESS: Found {target_file}")
        # Print the first 3 lines to prove content exists
        with open(target_file, 'r') as f:
            print(f"CONTENT PREVIEW:\n{f.read(100)}...")
    else:
        print(f"FAILURE: {target_file} does NOT exist.")
        # Print what IS in the folder to see where we went wrong
        print(f"Contents of {env.outbasepath}:")
        if os.path.exists(env.outbasepath):
            print(os.listdir(env.outbasepath))
        else:
            print(f"Directory {env.outbasepath} does not exist!")
    print("---------------------------\n")

    env.copy("changelog.rst")

    print("\n--- DEBUG: index.rst CONTENT ---")
    index_path = os.path.join(env.outbasepath, "index.rst")
    
    if os.path.exists(index_path):
        with open(index_path, 'r') as f:
            content = f.read()
            print(content)
            
            # Auto-check for the user
            if "changelog" in content:
                print("\n[CHECK] 'changelog' entry FOUND in toctree.")
            else:
                print("\n[ERROR] 'changelog' entry MISSING from toctree!")
    else:
        print(f"FAILURE: {index_path} does not exist.")
    print("--------------------------------\n")
