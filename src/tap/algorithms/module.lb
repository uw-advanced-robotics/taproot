def init(module):
    module.name = ":algorithms"
    module.description = "Taproot algorithms"

def prepare(module, options):
    return True

def build(env):
    env.outbasepath = "taproot/src/tap/algorithms"

    env.copy("MahonyAHRS.cpp")
    env.copy("MahonyAHRS.h")
    env.copy("ballistics.cpp")
    env.copy("ballistics.hpp")
    env.copy("butterworth.hpp")
    env.copy("cmsis_mat.hpp")
    env.copy("crc.cpp")
    env.copy("crc.hpp")
    env.copy("discrete_filter.hpp")
    env.copy("extended_kalman.cpp")
    env.copy("extended_kalman.hpp")
    env.copy("fuzzy_pd.cpp")
    env.copy("fuzzy_pd.hpp")
    env.copy("fuzzy_pd_rule_table.cpp")
    env.copy("fuzzy_pd_rule_table.hpp")
    env.copy("fuzzy_rule_table.hpp")
    env.copy("kalman_filter.hpp")
    env.copy("linear_interpolation_predictor.cpp")
    env.copy("linear_interpolation_predictor.hpp")
    env.copy("linear_interpolation_predictor_wrapped.cpp")
    env.copy("linear_interpolation_predictor_wrapped.hpp")
    env.copy("math_user_utils.cpp")
    env.copy("math_user_utils.hpp")
    env.copy("module.lb")
    env.copy("ramp.cpp")
    env.copy("ramp.hpp")
    env.copy("smooth_pid.cpp")
    env.copy("smooth_pid.hpp")
    env.copy("strtok.cpp")
    env.copy("strtok.hpp")
    env.copy("transforms")
    env.copy("wrapped_float.cpp")
    env.copy("wrapped_float.hpp")


    # env.copy(".", ignore=env.ignore_paths("odometry/*.**"))
