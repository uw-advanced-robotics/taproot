import sys
sys.path.append(repopath("scripts/lbuild-helpers"))
import board_info_parser
import re
from pathlib import Path

def init(module):
    module.name = ":board"
    module.description = "Project.xml files for modm HAL generation"

def prepare(module, options):    
    module.add_option(
        StringOption(
            name="digital_in_pins",
            description="Comma-separated list of digital in pins",
            default=""))

    module.add_option(
        StringOption(
            name="digital_out_pins",
            description="Comma-separated list of digital out pins",
            default=""))

    module.add_option(
        StringOption(
            name="analog_in_pins",
            description="Comma-separated list of analog in pins",
            default=""))

    module.add_option(
        StringOption(
            name="pwm_pins",
            description="Comma-separated list of PWM pins",
            default=""))

    board_info = board_info_parser.get_board_info()

    for instance in board_info.i2c.values + board_info.spi.values + board_info.uart.values:
        if instance.alias is None:
            module.add_option(
                StringOption(
                    name=f"{instance.display_name().lower()}_alias",
                    description=f"Alias for {instance.display_name()}",
                    default=""))

    return True

def get_apb_map(chip):
    # stm32f427iih6
    family = chip[:-6] + "xx"
    skew = chip[:-4] + "xx"
    content = Path(repopath(f"./modm/ext/st/stm32/{family}/Include/{skew}.h")).read_text(encoding="utf-8", errors="replace")

    # RCC_(APB1)ENR_(TIM1)EN
    match = re.findall(r"RCC_(APB\d)ENR_([A-Z0-9]+?)EN ", content)
    apb_map = {}
    for (reg, per) in match:
        if per.startswith("TIM"):
            per = per.replace("TIM", "Timer")
        apb_map[per.capitalize()] = reg.capitalize()

    return apb_map

def validate(env):
    metadata = board_info_parser.get_board_info()

    metadata.validate_configuration(env)

def build(env):
    metadata = board_info_parser.get_board_info()
    
    def extract_pin_defines(pins: str) -> str:
        pins = [pin.strip() for pin in str.split(pins, ",")]
        return [] if pins == [""] else pins

    def get_pins(user_pins, gpio_type):
        pins = []

        for pin in metadata.gpio_pins:
            if pin.gpio_type == gpio_type:
                pins.append(pin)
            elif pin.display_name() in user_pins:
                pins.append(pin)

        return pins

    digital_in_pins = get_pins(extract_pin_defines(env["digital_in_pins"]), "in")
    digital_out_pins = get_pins(extract_pin_defines(env["digital_out_pins"]), "out")
    analog_in_pins = get_pins(extract_pin_defines(env["analog_in_pins"]), "analog")
    pwm_pins = get_pins(extract_pin_defines(env["pwm_pins"]), "pwm")

    apb_map = get_apb_map(metadata.controller.chip)
    
    pin_mappings = { pin.alias: pin.name for pin in metadata.gpio_pins }

    env.substitutions = {
        "digital_in_pins": digital_in_pins,
        "digital_out_pins": digital_out_pins,
        "analog_in_pins": analog_in_pins,
        "pwm_pins": pwm_pins,
        "pin_mappings": pin_mappings,
        "chip": metadata.controller.chip,
        "clock": metadata.controller.clock,
        "apb_map": apb_map,
        "enabled_peripherals": metadata.get_enabled_peripherals(),
        "gpio_groups": metadata.gpio_groups,
        "spis": metadata.spi,
        "i2cs": metadata.i2c,
    }
    env.outbasepath = "taproot/src/tap/board"
    env.copy("board.cpp")
    env.template(f"board.hpp.in", "board.hpp")
