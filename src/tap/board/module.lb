import sys
sys.path.append(repopath("scripts/lbuild-helpers"))
import board_info_parser
import re
from pathlib import Path
from collections import defaultdict

def init(module):
    module.name = ":board"
    module.description = "Project.xml files for modm HAL generation"

def prepare(module, options):    
    module.add_option(
        StringOption(
            name="digital_in_pins",
            description="Comma-separated list of digital in pins",
            default=""))

    module.add_option(
        StringOption(
            name="digital_out_pins",
            description="Comma-separated list of digital out pins",
            default=""))

    module.add_option(
        StringOption(
            name="analog_in_pins",
            description="Comma-separated list of analog in pins",
            default=""))

    module.add_option(
        StringOption(
            name="pwm_pins",
            description="Comma-separated list of PWM pins",
            default=""))

    return True

def get_apb_map(chip):
    # stm32f427iih6
    family = chip[:-6] + "xx"
    skew = chip[:-4] + "xx"
    content = Path(repopath(f"./modm/ext/st/stm32/{family}/Include/{skew}.h")).read_text(encoding="utf-8", errors="replace")

    # RCC_(APB1)ENR_(TIM1)EN
    match = re.findall(r"RCC_(APB\d)ENR_([A-Z0-9]+?)EN ", content)
    apb_map = {}
    for (reg, per) in match:
        if per.startswith("TIM"):
            per = per.replace("TIM", "Timer")
        apb_map[per.capitalize()] = reg.capitalize()

    return apb_map

def build(env):
    def extract_pin_defines(pins: str) -> str:
        pins = [pin.strip() for pin in str.split(pins, ",")]
        return [] if pins == [""] else pins

    board_name = env[":dev_board"]

    digital_in_pins = extract_pin_defines(env["digital_in_pins"])
    digital_out_pins = extract_pin_defines(env["digital_out_pins"])
    analog_in_pins = extract_pin_defines(env["analog_in_pins"])
    pwm_pins = extract_pin_defines(env["pwm_pins"])

    metadata = board_info_parser.parse_board_info(env[":dev_board"])

    pins = digital_in_pins + digital_out_pins + analog_in_pins + pwm_pins
    assert len(pins) == len(set(pins)), "duplicate pin definitions"

    apb_map = get_apb_map(metadata.controller.chip)
    
    # TODO: Move this to the modm project file prepare. Add a dep to that module.
    #       Also consider selectively enabling these based on configuration? ie 2 perphis on the same GPIO
    #       How should configuration be handled seperately from the board.xml? do we consider that the actual configuration?
    enabled_peripherals_raw = defaultdict(set)
    for can in metadata.can:
        enabled_peripherals_raw["Can"].add(can.name)
    for i2c in metadata.i2c:
        enabled_peripherals_raw["I2c"].add(i2c.name)
    for spi in metadata.spi:
        enabled_peripherals_raw["Spi"].add(spi.name)
    for uart in metadata.uart:
        enabled_peripherals_raw["Uart"].add((uart.name, uart.usart))
    for pin in metadata.gpio_pins:
        if "timer" in pin.features.keys():
            enabled_peripherals_raw["Timer"].add(pin.features["timer"].name)
        if "adc" in pin.features.keys():
            enabled_peripherals_raw["Adc"].add(pin.features["adc"].name)
    
    enabled_peripherals = {}
    for peripheral_set, values in enabled_peripherals_raw.items():
        values = list(values)
        values.sort()
        if peripheral_set == "Uart":
            enabled_peripherals[peripheral_set] = [
                f"U{'s' if s else ''}art{n}" for n, s in values
            ]
        else:
            enabled_peripherals[peripheral_set] = [peripheral_set + str(v) for v in values]

    for pin in pins:
        assert any(metadata_pin.alias == pin for metadata_pin in metadata.gpio_pins),\
            f"invalid pin {pin}"

    pin_mappings = { pin.alias: pin.name for pin in metadata.gpio_pins }

    env.substitutions = {
        "digital_in_pins": digital_in_pins,
        "digital_out_pins": digital_out_pins,
        "analog_in_pins": analog_in_pins,
        "pwm_pins": pwm_pins,
        "pin_mappings": pin_mappings,
        "chip": metadata.controller.chip,
        "clock": metadata.controller.clock,
        "apb_map": apb_map,
        "enabled_peripherals": enabled_peripherals,
        "gpio_groups": metadata.gpio_groups,
        "spis": metadata.spi,
        "i2cs": metadata.i2c,
    }
    env.outbasepath = "taproot/src/tap/board"
    env.copy("board.cpp")
    env.template(f"board.hpp.in", "board.hpp")
