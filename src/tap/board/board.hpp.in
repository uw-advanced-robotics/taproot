#ifndef TAPROOT_BOARD_HPP_
#define TAPROOT_BOARD_HPP_

#ifndef PLATFORM_HOSTED
#include "modm/architecture/interface/clock.hpp"
#include "modm/platform.hpp"

using namespace modm::platform;
#else
#include "modm/math/units.hpp"
#endif

namespace Board
{
using namespace modm::literals;

/**
 * {{ chip | upper }} running at {{ clock.frequency }}MHz from the external {{ clock.crystal }}MHz crystal
 */
struct SystemClock
{
    static constexpr uint32_t Frequency = {{ clock.frequency }}_MHz;
    static constexpr uint32_t Ahb = Frequency{% if clock.prescalars["Ahb"] != 1 %} / {{ clock.prescalars["Ahb"] }}{% endif %};
    static constexpr uint32_t Apb1 = Ahb{% if clock.prescalars["Apb1"] != 1 %} / {{ clock.prescalars["Apb1"] }}{% endif %};
    static constexpr uint32_t Apb2 = Ahb{% if clock.prescalars["Apb2"] != 1 %} / {{ clock.prescalars["Apb2"] }}{% endif %};

%% if "Adc" in enabled_peripherals.keys()
    static constexpr uint32_t Adc = {{ apb_map[enabled_peripherals["Adc"][0].name()] }};

%% endif


%% macro configure_clocks(group, apb_clock_group="")
    %% if group in enabled_peripherals.keys()
        %% for periph in enabled_peripherals[group]
    static constexpr uint32_t {{ periph.name() }} = {{ apb_map[periph.name()] }}{{ apb_clock_group }};
        %% endfor
    %% endif
%% endmacro

{{ configure_clocks("Spi") }}
{{ configure_clocks("Uart") }}
{{ configure_clocks("Can") }}
{{ configure_clocks("I2c") }}
    static constexpr uint32_t Apb1Timer = Apb1{% if clock.prescalars["Apb1"] != 1 %} * 2{% endif %};
    static constexpr uint32_t Apb2Timer = Apb2{% if clock.prescalars["Apb2"] != 1 %} * 2{% endif %};
{{ configure_clocks("Timer", "Timer") }}
    static bool inline enable()
    {
#ifndef PLATFORM_HOSTED
        Rcc::enableExternalCrystal();  // {{ clock.crystal }} MHz
        Rcc::PllFactors pllF = {
            {{ clock.pll.m }},    // {{ clock.crystal }}MHz / M={{ clock.pll.m }} -> {{ clock.crystal // clock.pll.m }}MHz
            {{ clock.pll.n }},  // {{ clock.crystal // clock.pll.m }}MHz * N={{ clock.pll.n }} -> {{ clock.crystal // clock.pll.m * clock.pll.n}}MHz
            {{ clock.pll.p }}     // {{ clock.crystal // clock.pll.m * clock.pll.n}}MHz / P={{ clock.pll.p }} -> {{ clock.frequency }}MHz = F_cpu
        };
        Rcc::enablePll(Rcc::PllSource::ExternalCrystal, pllF);

        Rcc::setFlashLatency<Frequency>();
        Rcc::enableSystemClock(Rcc::SystemClockSource::Pll);
        Rcc::setAhbPrescaler(Rcc::AhbPrescaler::Div{{ clock.prescalars["Ahb"] }});
        Rcc::setApb1Prescaler(Rcc::Apb1Prescaler::Div{{ clock.prescalars["Apb1"] }});
        Rcc::setApb2Prescaler(Rcc::Apb2Prescaler::Div{{ clock.prescalars["Apb2"] }});
        Rcc::updateCoreFrequency<Frequency>();
#endif

        return true;
    }
};

#ifndef PLATFORM_HOSTED

{% for gpio_group in gpio_groups %}
    %% if gpio_group.comment is not none
// {{ gpio_group.comment }}
    %% endif

    %% for gpio in gpio_group.gpios
        %% if gpio.inverted
using {{ gpio.display_name() }} = GpioInverted<{{ gpio.name() }}>;
        %% else
using {{ gpio.display_name() }} = {{ gpio.name() }};
        %% endif
    %% endfor
using {{ gpio_group.name() }}sPort = SoftwareGpioPort<{% for gpio in gpio_group.gpios %}{{ gpio.display_name() }}{% if not loop.last %}, {% endif %}{% endfor %}>;
{% endfor %}

%% macro configure_pins(comment, pin_group_name, pins)
    %% if pins|length > 0
// {{ comment }}
        %% if pins|length > 0 
            %% for pin in pins
                %% set display_name = (pin_group_name if pin.gpio_type == "gpio" else "") + pin.display_name()
                %% if pin.inverted
using {{ display_name }} = GpioInverted<{{ pin.name() }}>;
                %% else
using {{ display_name }} = {{ pin.name() }};
                %% endif
            %% endfor
        %% endif 
using {{ pin_group_name }}s = SoftwareGpioPort<{% for pin in pins %}{% if pin.gpio_type == "gpio" %}{{ pin_group_name }}{% endif %}{{ pin.display_name() }}{% if not loop.last %}, {% endif %}{% endfor %}>;
    %% endif
%% endmacro

{{ configure_pins("Initialize analog input pins", "AnalogInPin", analog_in_pins) }}
{{ configure_pins("Initialize PWM pins", "PWMOutPin", pwm_pins) }}
{{ configure_pins("Initialize digital input pins", "DigitalInPin", digital_in_pins) }}
{{ configure_pins("Initialize digital output pins", "DigitalOutPin", digital_out_pins) }}

%% for spi in spis
    %% if spi.comment is not none
// {{ spi.comment }}
    %% endif
using {{ spi.display_name() }}Sck = {{ spi.sck }};
using {{ spi.display_name() }}Poci = {{ spi.poci }};
using {{ spi.display_name() }}Pico = {{ spi.pico }};
    %% for spi_gpio in spi.gpios
using {{ spi_gpio.display_name() }} = {{ spi_gpio.name() }};
    %% endfor
using {{ spi.display_name() }}{% if spi.alias is not none %}Spi{% endif %} = SpiMaster{{ spi.raw_name }};

%% endfor

%% for i2c in i2cs
    %% if i2c.comment is not none
// {{ i2c.comment }}
    %% endif
using {{ i2c.display_name() }}Sda = {{ i2c.sda }};
using {{ i2c.display_name() }}Scl = {{ i2c.scl }};
    %% for i2c_gpio in i2c.gpios
using {{ i2c_gpio.display_name() }} = {{ i2c_gpio.name() }};
    %% endfor
using {{ i2c.display_name()}}{% if i2c.alias is not none %}I2c{% endif %} = I2cMaster{{ i2c.raw_name }};

%% endfor

#endif

inline void initialize()
{
    // init clock
    SystemClock::enable();
#ifndef PLATFORM_HOSTED
    SysTickTimer::initialize<SystemClock>();
#endif
}

#ifndef PLATFORM_HOSTED

%% for spi in spis
    %% set name = spi.display_name() + ("" if spi.alias is none else "Spi")
template <uint32_t Baudrate = 10000000>
inline void initialize{{ name }}()
{
    {{ name }}::connect<{{ spi.display_name() }}Poci::Miso, {{ spi.display_name() }}Pico::Mosi, {{ spi.display_name() }}Sck::Sck>();
    {{ name }}::initialize<SystemClock, Baudrate>();
}

%% endfor



%% for i2c in i2cs
    %% set name = i2c.display_name() + ("" if i2c.alias is none else "I2c")
template <uint32_t Baudrate = 100000>
inline void initialize{{ name }}({{ name }}::PullUps pullups = {{ name }}::PullUps::Internal)
{
    {{ name }}::connect<{{ i2c.display_name() }}Scl::Scl, {{ i2c.display_name() }}Sda::Sda>(pullups);
    {{ name }}::initialize<SystemClock, Baudrate>();
}
%% endfor

#endif

}  // namespace Board

#endif  // TAPROOT_BOARD_HPP_

