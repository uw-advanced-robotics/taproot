import sys
sys.path.append(repopath("scripts/lbuild-helpers"))
import board_info_parser

TERMINAL_SERIAL_FILES = ["scheduler_terminal_handler.cpp", "scheduler_terminal_handler.hpp"]

class TerminalSerial(Module):
    def init(self, module):
        module.name = ":control:terminal_serial"
    
    def prepare(self, module, options):
        module.depends("taproot:communication:serial:terminal_serial")
        
        return board_info_parser.get_board_info().uart.aliased("TerminalSerial") != None

    def build(self, env):
        env.outbasepath = "taproot/src/tap/control"

        for file in TERMINAL_SERIAL_FILES:
            env.copy(file)

def init(module):
    module.name = ":control"
    module.description = "Robot control systems"

def prepare(module, options):
    # General Depends
    module.depends(":drivers")

    # Remote Map State -> To be replaced with triggers
    module.depends(":communication:serial:remote")

    # Needed for command scheduler time overrun check
    module.depends(":architecture")

    # Needed for chassis power limiter
    module.depends(":communication:sensors:current")
    module.depends(":communication:sensors:voltage")
    module.depends(":communication:serial:ref_serial")

    module.add_submodule(TerminalSerial())
    
    return True

def build(env):
    env.outbasepath = "taproot/src/tap/control"

    env.copy(".", ignore=env.ignore_files(*TERMINAL_SERIAL_FILES))


