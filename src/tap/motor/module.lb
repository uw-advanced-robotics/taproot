def init(module):
    module.name = ":motor"
    module.description = "Motor control"

def prepare(module, options):
    module.depends(
        ":drivers",
        ":algorithms",
        ":communication:sensors:encoder",
        ":communication:can")

    return True

def build(env):
    env.outbasepath = "taproot/src/tap/motor"
    pwmFiles = ["servo.cpp", "servo.hpp"]
    terminalFiles = ["dji_motor_terminal_serial_handler.hpp", "dji_motor_terminal_serial_handler.cpp"]
    env.copy(".", ignore=env.ignore_files(*(terminalFiles + pwmFiles)))

    if env.has_module(":communication:serial:terminal_serial"):
        for file in terminalFiles:
            env.copy(file)

    if env.has_module(":communication:gpio:pwm"):
        for file in pwmFiles:
            env.copy(file)
