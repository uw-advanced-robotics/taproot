#include "digital.hpp"

#include "tap/board/board.hpp"
#include "tap/util_macros.hpp"

using namespace Board;

{% macro in_pin_name(pin) %}Board::{% if pin.gpio_type != "in" %}DigitalInPin{% endif %}{{ pin.display_name() }}{% endmacro %}
{% macro out_pin_name(pin) %}Board::{% if pin.gpio_type != "out" %}DigitalOutPin{% endif %}{{ pin.display_name() }}{% endmacro %}
namespace tap
{
namespace gpio
{
void Digital::init()
{
#ifndef PLATFORM_HOSTED
%% if output_pins | selectattr('gpio_type', 'ne', 'out') | list | length > 0
    // init digital out pins
    DigitalOutPins::setOutput(modm::Gpio::Low);
%% endif
%% if input_pins | selectattr('gpio_type', 'ne', 'in') | list | length > 0
    // init digital in pins
    // interrupts disabled
    DigitalInPins::setInput();
%% endif
#endif
}

void Digital::configureInputPullMode(Digital::InputPin pin, Digital::InputPullMode mode)
{
#ifdef PLATFORM_HOSTED
    UNUSED(pin);
    UNUSED(mode);
#else
%% if input_pins|length == 0
    UNUSED(mode);
%% endif
    switch (pin)
    {
%% for pin in input_pins
        case Digital::InputPin::{{ pin.display_name() }}:
            {{ in_pin_name(pin) }}::configure(mode);
            break;
%% endfor
    }
#endif
}

void Digital::set(Digital::OutputPin pin, bool isSet)
{
#ifdef PLATFORM_HOSTED
    UNUSED(pin);
    UNUSED(isSet);
#else
%% if output_pins|length == 0
    UNUSED(isSet);
%% endif
    switch (pin)
    {
%% for pin in output_pins
        case Digital::OutputPin::{{ pin.display_name() }}:
            {{ out_pin_name(pin) }}::set(isSet);
            break;
%% endfor
    }
#endif
}

bool Digital::read(Digital::InputPin pin) const
{
#ifdef PLATFORM_HOSTED
    UNUSED(pin);
    return false;
#else
    switch (pin)
    {
%% for pin in input_pins
        case Digital::InputPin::{{ pin.display_name() }}:
            return {{ in_pin_name(pin) }}::read();
%% endfor
        default:
            return false;
    }
#endif
}
}  // namespace gpio

}  // namespace tap

