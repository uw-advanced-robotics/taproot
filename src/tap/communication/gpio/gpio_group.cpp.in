#include "{{ file_name }}.hpp"

#include "tap/board/board.hpp"
#include "tap/util_macros.hpp"

using namespace Board;

namespace tap
{
namespace gpio
{
void {{ name }}::init()
{
#ifndef PLATFORM_HOSTED
    // init {{ name }}
    {{ name }}Port::setOutput(modm::Gpio::{{ group.default }});
#endif
}

void {{ name  }}::set({{ name }}::{{ group.name() }}Pin pin, bool set)
{
#ifdef PLATFORM_HOSTED
    UNUSED(pin);
    UNUSED(set);
#else
    switch (pin)
    {
%% for pin in group.gpios
        case {{ name  }}::{{ group.name() }}Pin::{{ pin.alias }}:
            {{ pin.display_name() }}::set(set);
            break;
%% endfor
    }
#endif
}
}  // namespace gpio

}  // namespace tap

