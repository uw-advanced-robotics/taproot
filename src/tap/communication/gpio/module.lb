import sys
sys.path.append(repopath("lbuild-scripts"))
import board_info_parser
from collections import defaultdict

def extractPinDefines(pins):
    pins = [pin.strip() for pin in str.split(pins, ",")]
    return [] if pins == [""] else pins

class Analog(Module):
    def __init__(self, board_info):
        self.board_info = board_info
        
    def init(self, module):
        module.name = ":communication:gpio:analog"

    def prepare(self, module, options):
        module.depends(":board")
        return True

    def build(self, env):
        user_pins = extractPinDefines(env[":board:analog_in_pins"])

        pins = []
        for name, pin in self.board_info.get_all_gpio_pins().items():
            if name in user_pins:
                assert "adc" in pin.features, f"Pin {pin.name} does not have an ADC associated with it"
                pins.append(pin)
            elif pin.gpio_type == "analog":
                pins.append(pin)

        adcs = defaultdict(list)
        for pin in pins:
            feature = pin.features["adc"]
            adcs[f"Adc{feature.adc.raw_name}"].append(pin) 

        env.substitutions = {
            "pins": sorted(pins, key=lambda p: (p.features["adc"].adc.raw_name, p.features["adc"].in_channel)),
            "adcs": self.board_info.adcs,
        }
        env.outbasepath = "taproot/src/tap/communication/gpio"
        env.template("analog.cpp.in", "analog.cpp")
        env.template("analog.hpp.in", "analog.hpp")

class Digital(Module):
    def __init__(self, board_info):
        self.board_info = board_info

    def init(self, module):
        module.name = ":communication:gpio:digital"

    def prepare(self, module, options):
        module.depends(":board")
        return True

    def build(self, env):
        def get_pins(user_pins, gpio_type):
            pins = []

            for pin in self.board_info.gpio_pins:
                if pin.display_name() in user_pins:
                    pins.append(pin)
                elif pin.gpio_type == gpio_type:
                    pins.append(pin)

            return sorted(pins, key=lambda p: (p.gpio_type == gpio_type, p.display_name()))
        
        input_pins = get_pins(extractPinDefines(env[":board:digital_in_pins"]), "in")
        output_pins = get_pins(extractPinDefines(env[":board:digital_out_pins"]), "out")

        env.substitutions = {
            "input_pins": input_pins,
            "output_pins": output_pins,
        }
        env.outbasepath = "taproot/src/tap/communication/gpio"
        env.template("digital.cpp.in", "digital.cpp")
        env.template("digital.hpp.in", "digital.hpp")

class Leds(Module):
    def init(self, module):
        module.name = ":communication:gpio:leds"

    def prepare(self, module, options):
        module.depends(":board")
        return True

    def build(self, env):
        env.outbasepath = "taproot/src/tap/communication/gpio"
        env.template("leds.cpp.in", "leds.cpp")
        env.template("leds.hpp.in", "leds.hpp")

class Pwm(Module):
    def __init__(self, board_info):
        self.board_info = board_info

    def init(self, module):
        module.name = ":communication:gpio:pwm"

    def prepare(self, module, options):
        module.depends(":board")
        module.depends(":algorithms")
        return True

    def build(self, env):
        # Collect pins
        user_pins = listify(extractPinDefines(env[":board:pwm_pins"]))

        pins = []
        chs = set()
        for name, pin in self.board_info.get_all_gpio_pins().items():
            if name in user_pins:
                assert "timer" in pin.features, f"Pin {pin.name()} does not have a Timer associated with it"
                pins.append(pin)
                chs.add(pin.features["timer"].channel)
            elif pin.gpio_type == "pwm":
                pins.append(pin)
                chs.add(pin.features["timer"].channel)          

        env.substitutions = {
            "pins": sorted(pins, key=lambda p: (p.features["timer"].timer.raw_name, p.features["timer"].channel)),
            "timers": self.board_info.timers,
            "chs": sorted(list(chs)),
        }
        env.outbasepath = "taproot/src/tap/communication/gpio"
        env.template("pwm.cpp.in", "pwm.cpp")
        env.template("pwm.hpp.in", "pwm.hpp")

def init(module):
    module.name = ":communication:gpio"
    module.description = "Various GPIO HAL wrappers"

def prepare(module, options):
    module.depends(":board")

    board_info = board_info_parser.parse_board_info(options[":dev_board"])
    module.add_submodule(Analog(board_info))
    module.add_submodule(Digital(board_info))
    module.add_submodule(Leds())
    module.add_submodule(Pwm(board_info))

    return True

def build(env):
    pass
