#include "pwm.hpp"

#include "tap/algorithms/math_user_utils.hpp"
#include "tap/board/board.hpp"
#include "tap/util_macros.hpp"

using namespace Board;
using namespace tap::algorithms;

{% macro pin_name(pin) %}Board::{% if pin.gpio_type != "pwm" %}PWMOutPin{% endif %}{{ pin.display_name() }}{% endmacro %}
namespace tap
{
namespace gpio
{
void Pwm::init()
{
#ifndef PLATFORM_HOSTED

%% for timer in timers
    {{ timer.name() }}::connect<{% for pin in pins if pin.features["timer"].timer == timer %}{{ pin_name(pin) }}::{{ pin.features["timer"].channel }}{% if not loop.last %}, {% endif %}{% endfor %}>();
    {{ timer.name() }}::enable();
    {{ timer.name() }}::setMode({{ timer.name() }}::Mode::UpCounter);
    timer{{ timer.raw_name }}CalculatedOverflow = {{ timer.name() }}::setPeriod<Board::SystemClock>(1'000'000 / DEFAULT_TIMER{{ timer.raw_name }}_FREQUENCY);
    {{ timer.name() }}::start();
    {{ timer.name() }}::enableOutput();

%% endfor
#endif
    // Set all out pins to 0 duty
    writeAllZeros();
}

void Pwm::writeAllZeros()
{
#ifndef PLATFORM_HOSTED
%% for pin in pins
    write(0.0f, Pin::{{ pin.display_name() }});
%% endfor
#endif
}

void Pwm::write(float duty, Pin pin)
{
#ifdef PLATFORM_HOSTED
    UNUSED(duty);
    UNUSED(pin);
#else
    duty = limitVal<float>(duty, 0.0f, 1.0f);
    switch (pin)
    {
%% for pin in pins
    %% set timer = pin.features["timer"].timer.raw_name
        case Pin::{{ pin.display_name() }}:
            Timer{{ timer }}::configureOutputChannel(
                {{ pin.features["timer"].channel }},
                Timer{{ timer }}::OutputCompareMode::Pwm,
                duty * timer{{ timer }}CalculatedOverflow);
            break;
%% endfor
        default:
            break;
    };
#endif
}

void Pwm::setTimerFrequency(Timer timer, uint32_t frequency)
{
#ifdef PLATFORM_HOSTED
    UNUSED(timer);
    UNUSED(frequency);
#else
    switch (timer)
    {
%% for timer in timers
        case TIMER{{ timer.raw_name }}:
            timer{{ timer.raw_name }}CalculatedOverflow = {{ timer.name() }}::setPeriod<Board::SystemClock>(1'000'000 / frequency);
            break;
%% endfor
    }
#endif
}

void Pwm::pause(Timer timer)
{
#ifdef PLATFORM_HOSTED
    UNUSED(timer);
#else
    switch (timer)
    {
%% for timer in timers
        case TIMER{{ timer.raw_name }}:
            {{ timer.name() }}::pause();
            break;
%% endfor
    }
#endif
}

void Pwm::start(Timer timer)
{
#ifdef PLATFORM_HOSTED
    UNUSED(timer);
#else
    switch (timer)
    {
%% for timer in timers
        case TIMER{{ timer.raw_name }}:
            {{ timer.name() }}::start();
            break;
%% endfor
    }
#endif
}
}  // namespace gpio

}  // namespace tap

