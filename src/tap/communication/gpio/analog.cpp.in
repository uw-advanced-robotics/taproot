#include "analog.hpp"

#include "tap/board/board.hpp"
#include "tap/util_macros.hpp"

using namespace Board;

{% macro pin_name(pin) %}Board::{% if pin.gpio_type != "analog" %}AnalogInPin{% endif %}{{ pin.display_name() }}{% endmacro %}
namespace tap
{
namespace gpio
{
void Analog::init()
{
#ifndef PLATFORM_HOSTED
%% if pins | selectattr('gpio_type', 'ne', 'analog') | select | first
    AnalogInPins::setAnalogInput();
%% endif
{% for adc in adcs %}
    // Initial ADC/Timer setup
    {{ adc }}::connect<{% for pin in adcs[adc] %}{{ pin_name(pin) }}::{{ pin.features["adc"].in_channel }}{% if not loop.last %}, {% endif %}{% endfor %}>();
    {{ adc }}::initialize<SystemClock, 22500000_Bd>();

    %% for pin in adcs[adc]
    {{ adc }}::setPinChannel<{{ pin_name(pin) }}>();
    %% endfor
{% endfor %}
#endif
}

uint16_t Analog::read(Pin pin) const
{
#ifdef PLATFORM_HOSTED
    UNUSED(pin);
    return 0;
#else
    switch (pin)
    {
%% for pin in pins
        case Pin::{{ pin.display_name() }}:
            return Adc{{ pin.features["adc"].name }}::readChannel(Adc{{ pin.features["adc"].name }}::getPinChannel<{{ pin_name(pin) }}>());
%% endfor
        default:
            return 0;
    }
#endif
}
}  // namespace gpio

}  // namespace tap

