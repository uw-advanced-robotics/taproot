#include "analog.hpp"

#include "tap/board/board.hpp"
#include "tap/util_macros.hpp"

using namespace Board;

{% macro pin_name(pin) %}Board::{% if pin.gpio_type != "analog" %}AnalogInPin{% endif %}{{ pin.display_name() }}{% endmacro %}
namespace tap
{
namespace gpio
{
void Analog::init()
{
#ifndef PLATFORM_HOSTED
%% if pins | selectattr('gpio_type', 'ne', 'analog') | list | length > 0
    AnalogInPins::setAnalogInput();
%% endif
{% for adc in adcs %}
    // Initial ADC/Timer setup
    {{ adc.name() }}::connect<{% for pin in adc.pins if pin in pins %}{{ pin_name(pin) }}::{{ pin.adc.in_channel }}{% if not loop.last %}, {% endif %}{% endfor %}>();
    {{ adc.name() }}::initialize<SystemClock, 22500000_Bd>();

    %% for pin in adc.pins if pin in pins
    {{ adc.name() }}::setPinChannel<{{ pin_name(pin) }}>();
    %% endfor
{% endfor %}
#endif
}

uint16_t Analog::read(Pin pin) const
{
#ifdef PLATFORM_HOSTED
    UNUSED(pin);
    return 0;
#else
    switch (pin)
    {
%% for pin in pins
        case Pin::{{ pin.display_name() }}:
            return {{ pin.adc.adc.name() }}::readChannel({{ pin.adc.adc.name() }}::getPinChannel<{{ pin_name(pin) }}>());
%% endfor
        default:
            return 0;
    }
#endif
}
}  // namespace gpio

}  // namespace tap

