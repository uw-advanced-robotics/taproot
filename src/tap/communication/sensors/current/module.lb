class Analog(Module):
    def init(self, module):
        module.name = ":communication:sensors:current:analog"
    
    def prepare(self, module, options):
        module.depends(":communication:gpio:analog")

        return True

    def build(self, env):
        env.outbasepath = "taproot/src/tap/communication/sensors/current"
    
        env.copy("analog_current_sensor.cpp")
        env.copy("analog_current_sensor.hpp")

def init(module):
    module.name = ":communication:sensors:current"
    module.description = "Current sensor interface and various current sensors"

def prepare(module, options):
    module.add_submodule(Analog())
    return True

def build(env):
    env.outbasepath = "taproot/src/tap/communication/sensors/current"
    
    env.copy("current_sensor_interface.hpp")