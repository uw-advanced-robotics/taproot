import sys
sys.path.append(repopath("scripts/lbuild-helpers"))
import board_info_parser

class Display(Module):
    def init(self, module):
        module.name = ":communication:sensors:imu:display"
    
    def prepare(self, module, options):
        module.depends("taproot:display")
        
        return True

    def build(self, env):
        env.outbasepath = "taproot/src/tap/communication/sensors/imu"

        env.copy("imu_menu.hpp")
        env.copy("imu_menu.cpp")

class TerminalSerial(Module):
    def init(self, module):
        module.name = ":communication:sensors:imu:terminal_serial"
    
    def prepare(self, module, options):
        module.depends("taproot:communication:serial:terminal_serial")
        
        return board_info_parser.parse_board_info(options[":dev_board"]).uart.aliased("TerminalSerial") != None

    def build(self, env):
        env.outbasepath = "taproot/src/tap/communication/sensors/imu"

        env.copy("imu_terminal_serial_handler.hpp")
        env.copy("imu_terminal_serial_handler.cpp")


def init(module):
    module.name = ":communication:sensors:imu"
    module.description = "Drivers, OLED menu, and terminal serial handler for various IMU sensors"

def prepare(module, options):
    module.depends(":algorithms")
    module.depends(":architecture")

    module.add_submodule(Display())
    module.add_submodule(TerminalSerial())

    return True

def build(env):
    env.outbasepath = "taproot/src/tap/communication/sensors/imu"
    env.copy("imu_interface.hpp")
    env.copy("abstract_imu.hpp")
    env.copy("abstract_imu.cpp")        
