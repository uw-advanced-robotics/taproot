import sys
sys.path.append(repopath("scripts/lbuild-helpers"))
import board_info_parser

def init(module):
    module.name = ":communication:sensors:imu:bmi088"
    module.description = "Robomaster Development Board Type C specific communication" \
        "with the on board bmi088"

def prepare(module, options):
    module.depends(":communication:sensors:imu_heater")
    module.depends(":communication:sensors:imu")

    spi = board_info_parser.get_board_info().spi.aliased("Imu")
    # Currently the interrupts are not used, only need to check these two
    return spi is not None and any(pin.display_name() == "ImuCS1Accel" for pin in spi.gpios) and any(pin.display_name() == "ImuCS1Gyro" for pin in spi.gpios)

def build(env):
    env.outbasepath = "taproot/src/tap/communication/sensors/imu/bmi088"
    env.copy(".")
