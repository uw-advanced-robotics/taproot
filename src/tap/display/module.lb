# TODO this module needs some cleaning up, see this issue: https://gitlab.com/aruw/controls/taproot/-/issues/51

class Motor(Module):
    def init(self, module):
        module.name = ":display:motor"
    
    def prepare(self, module, options):
        module.depends(":motor")
        
        return True

    def build(self, env):
        env.outbasepath = "taproot/src/tap/display"
        env.copy("motor_menu.cpp")
        env.copy("motor_menu.hpp")
        env.copy("motor_specific_menu.cpp")
        env.copy("motor_specific_menu.hpp")

class Control(Module):
    def init(self, module):
        module.name = ":display:control"
    
    def prepare(self, module, options):
        module.depends(":control")
        
        return True

    def build(self, env):
        env.outbasepath = "taproot/src/tap/display"
        env.copy("command_scheduler_menu.cpp")
        env.copy("command_scheduler_menu.hpp")
        env.copy("hardware_test_menu.cpp")
        env.copy("hardware_test_menu.hpp")

class RefSerial(Module):
    def init(self, module):
        module.name = ":display:ref_serial"
    
    def prepare(self, module, options):
        module.depends(":communication:serial:ref_serial")
        
        return True

    def build(self, env):
        env.outbasepath = "taproot/src/tap/display"
        env.copy("ref_serial_menu.cpp")
        env.copy("ref_serial_menu.hpp")

def init(module):
    module.name = ":display"
    module.description = "Support for displaying information on an OLED display." \
        "Currently this module contains sh1106-specific display code as well as " \
        "generic menu objects that you can use. This software is designed and tested " \
        "to be used on the RoboMaster Development Board OLED " \
        "(https://www.robomaster.com/en-US/products/components/general/development-board)"

def prepare(module, options):
    module.depends(":board")
    module.depends(":drivers")

    module.depends(":communication:gpio:analog")

    module.add_submodule(Motor())
    module.add_submodule(Control())
    module.add_submodule(RefSerial())

    return True

def build(env):
    env.outbasepath = "taproot/src/tap/display"

    env.copy("dummy_allocator.hpp")
    env.copy("oled_button_handler.cpp")
    env.copy("oled_button_handler.hpp")
    env.copy("vertical_scroll_logic_handler.cpp")
    env.copy("vertical_scroll_logic_handler.hpp")
