import sys
import itertools
import operator
sys.path.append(repopath("gitlab-ci-scripts"))
import collect_modules

def subslices(seq):
    "Return all contiguous non-empty subslices of a sequence."
    # subslices('ABCD') → A AB ABC ABCD B BC BCD C CD D
    slices = itertools.starmap(slice, itertools.combinations(range(len(seq) + 1), 2))
    return map(operator.getitem, itertools.repeat(seq), slices)

def init(module):
    module.name = ":ci-scripts"
    module.description = "Taproot CI scripts"

def prepare(module, options):
    module.depends(
        ":build",
        ":modm-project.xml")

    return True

def build(env):
    env.outbasepath = "taproot/ci-scripts"

    info = collect_modules.collect_generation_information()

    build_all_configs = []
    configs = []

    for device, config in sorted(info.items(), key=lambda e: e[0]):
        for module, options in sorted(config.items(), key=lambda e: e[0]):
            modules = module

            if module == "all":
                modules = ",".join(sorted(list(config.keys() - {"all"})))

            if len(options) == 0:
                name = f"Device: {device}, Module: {module}"
                configs.append(
                    {
                        "name": name,
                        "device": device,
                        "modules": modules,
                        "options": ""
                    }
                )
            else:
                for opt_set in subslices(list(options)):
                    option_vals = {o: o in opt_set for o in options}
                    option_vals = ",".join(f'{o}={v}' for o, v in option_vals.items())
                    name = f"Device: {device}, Module: {module}, Options: {option_vals}"
                    configs.append(
                        {
                            "name": name,
                            "device": device,
                            "modules": modules,
                            "options": option_vals
                        }
                    )


    env.substitutions = {
        "configs": configs
    }
    env.template("build.yml.in", "build.yml")
